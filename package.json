{
  "name": "free-google-serp",
  "version": "1.0.0",
  "description": "Bypass search API subscription costs by translating raw Google Search results pages into JSON.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "utility",
    "free-google-serp",
    "google",
    "serp",
    "search",
    "free-search",
    "rag"
  ],
  "author": "Antigravity Factory Manager",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeHalogen/free-google-serp.git"
  },
  "homepage": "https://github.com/MeHalogen/free-google-serp#readme"
}
